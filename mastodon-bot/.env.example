# 봇 계정이 있는 마스토돈 서버 주소입니다. 계정 주소가 아니라 서버 주소만 넣어 주세요.
MASTODON_BASE_URL=https://uri.life

# 마스토돈 개발자 설정에서 새로 만든 액세스 토큰입니다.
MASTODON_ACCESS_TOKEN=여기에_새_토큰을_넣어주세요

# 답글 공개 범위: public / unlisted / private / direct
BOT_VISIBILITY=unlisted

# 새 멘션 확인 주기입니다. 빠른 반응을 원하면 1을 사용하세요.
POLL_INTERVAL_SECONDS=1

# 오늘의운세 날짜 기준입니다.
TIMEZONE=Asia/Seoul

# true면 모르는 명령어에도 사용법을 답합니다.
REPLY_ON_UNKNOWN=false

# false면 첫 실행 시 기존 멘션은 건너뛰고 새 멘션부터 답합니다.
STARTUP_CATCHES_OLD_MENTIONS=false
